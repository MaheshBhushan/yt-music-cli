Screen {
    layout: vertical;
}

#search-pane {
    height: 1fr;
}

#middle-row {
    height: 1fr;
}

#queue-pane {
    width: 1fr;
}

#playlists-pane {
    width: 1fr;
}

#lyrics-pane {
    width: 2fr;
    border-left: solid $panel;
}

#lyrics-scroll {
    height: 1fr;
}

/* the now-playing strip sits directly on the shortcut bar: cover on the
   left, text bottom-aligned so it lines up with the foot of the cover */
#now-playing {
    height: 8;
}

#now-playing-art {
    width: 16;
    height: 8;
    margin-right: 1;
}

#now-playing-text {
    height: 8;
    align-vertical: bottom;
}

#now-playing-track, #now-playing-artist {
    height: auto;
}

#now-playing-bar {
    height: 1;
}

#now-playing-progress {
    width: 1fr;
}

#now-playing-progress Bar {
    width: 1fr;
}

#now-playing-time, #now-playing-volume {
    width: auto;
    margin-left: 1;
}

/* only takes up a row while there is an error to show */
#error-banner {
    color: red;
    height: auto;
    display: none;
}

#shortcut-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
}

#now-playing-image {
    width: 100%;
    height: 100%;
}
