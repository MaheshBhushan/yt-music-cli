Screen {
    layout: vertical;
}

#search-pane {
    height: 1fr;
}

#middle-row {
    height: 1fr;
}

#queue-pane {
    width: 1fr;
}

#playlists-pane {
    width: 1fr;
}

#lyrics-pane {
    width: 2fr;
    border-left: solid $panel;
}

#lyrics-scroll {
    height: 1fr;
}

#now-playing {
    height: 8;
}

#now-playing-art {
    width: 16;
    height: 8;
    margin-right: 1;
}

#now-playing-text {
    height: 8;
}

#error-banner {
    color: red;
    height: auto;
}

#shortcut-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
}

#now-playing-image {
    width: 100%;
    height: 100%;
}
