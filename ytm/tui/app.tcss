Screen {
    layout: vertical;
}

#search-pane {
    height: 1fr;
}

#middle-row {
    height: 1fr;
}

/* middle row: queue 2 : playlists 1 : lyrics 2 -- the playlist list is
   short and narrow, queue titles are long */
#queue-pane {
    width: 2fr;
}

#playlists-pane {
    width: 1fr;
    min-width: 28;
}

#playlist-name {
    display: none;
}

/* wide rows are cut, not scrolled sideways */
#queue-table, #playlists-table {
    scrollbar-size-horizontal: 0;
}

#lyrics-pane {
    width: 2fr;
    border-left: solid $panel;
}

#lyrics-scroll {
    height: 1fr;
}

/* the now-playing strip sits directly on the shortcut bar: cover on the
   left, text bottom-aligned so it lines up with the foot of the cover */
#now-playing {
    height: 8;
}

#now-playing-art {
    width: 16;
    height: 8;
    margin-right: 1;
}

#now-playing-text {
    height: 8;
    align-vertical: bottom;
}

#now-playing-track, #now-playing-artist {
    height: auto;
}

#now-playing-queue {
    height: auto;
    color: $text-muted;
}

#now-playing-played, #now-playing-upnext {
    width: 1fr;
}

#now-playing-bar {
    height: 1;
}

#now-playing-progress {
    width: 1fr;
}

#now-playing-progress Bar {
    width: 1fr;
}

#now-playing-time, #now-playing-volume {
    width: auto;
    margin-left: 1;
}

/* only takes up a row while there is an error to show */
#error-banner {
    color: red;
    height: auto;
    display: none;
}

#shortcut-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    /* the entries are click targets, but drawn as plain text */
    link-style: none;
    link-color: $text-muted;
    link-background: $surface;
    link-style-hover: bold;
    link-color-hover: $text;
    link-background-hover: $surface;
}

#now-playing-image {
    width: 100%;
    height: 100%;
}

/* scrollbars: one cell wide, muted, brighter only while dragged or hovered,
   so they read as a gutter rather than a second widget */
* {
    scrollbar-size: 1 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $panel-lighten-2;
    scrollbar-color-hover: $text-muted;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $surface;
}

/* compact layout: a terminal too small for everything keeps only the search
   box, the queue, the now-playing strip and the shortcut bar (see
   YTMApp.on_resize) */
.compact #search-results,
.compact #now-playing-queue,
.compact #playlists-pane,
.compact #lyrics-pane {
    display: none;
}

.compact #search-pane {
    height: auto;
}

.compact #now-playing,
.compact #now-playing-art,
.compact #now-playing-text {
    height: 4;
}
